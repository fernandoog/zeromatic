# Copiar a /etc/zeromatic/email.env y rellenar
MAIL_TO=tu@email.com
MAIL_FROM=tu@email.com
GMAIL_USER=tu@email.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Número de la línea del contestador (aparece como Called-ID en el correo)
LINE_NUMBER=912345678
# Destino de SMS reenviados (si vacío, se usa MAIL_TO)
SMS_MAIL_TO=avisos@example.com
# Opcional: OPENAI_API_KEY=sk-...  (mejor transcripción; si no, usa Google Web Speech)
