[Unit]
Description=Buzonera — contestador telefónico automático (módem USB Conexant CX93010)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MODEM_DEVICE=/dev/ttyACM0
Environment=MODEM_BAUD=115200
Environment=RINGS_TO_ANSWER=1
Environment=MAX_RECORD_SEC=90
Environment=SILENCE_HANG_SEC=2.0
Environment=SILENCE_RMS_THRESH=10
Environment=MIN_MESSAGE_SEC=1.0
ExecStartPre=/bin/sleep 2
ExecStart=/opt/buzonera/venv/bin/python3 /opt/buzonera/bin/buzonera_daemon.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
