# Copiar a /etc/zeromatic/gprs.env y ajustar APN del operador
# Fallback GPRS (2G) cuando WiFi no llega a Internet — solo en post-procesado de mensajes

# 1 = intentar GPRS si falla la red (WiFi/Ethernet)
GPRS_FALLBACK=1

# APN de datos de tu operador (obligatorio para fallback)
# Movistar: telefonica.es | Orange: internet | Vodafone: airtelnet.es
GPRS_APN=internet

# Mismo puerto que MODEM_DEVICE (PPP libera el UART parando zeromatic unos segundos)
GPRS_DEVICE=/dev/ttyUSB0
GPRS_BAUD=115200

# Comprobación de conectividad antes de usar GPRS
NET_CHECK_HOST=smtp.gmail.com
NET_CHECK_PORT=587

# Tiempo máximo esperando PPP (segundos)
GPRS_CONNECT_TIMEOUT=90
